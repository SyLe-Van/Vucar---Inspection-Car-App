# Production Environment Variables
# 📋 Copy this file to .env.production and update with your actual values

# 📱 Application Configuration
ENVIRONMENT=production
NODE_ENV=production
PORT=3000
APP_PORT=80

# 🐳 Docker Registry Configuration
DOCKER_REGISTRY=docker.io
DOCKER_IMAGE_NAME=syle712/vucar-app  # ✅ Your Docker Hub username
DOCKER_TAG=latest

# 🌐 Domain Configuration
DOMAIN=vucar.syledevops.live  # ✅ VuCar subdomain
NEXTAUTH_URL=https://vucar.syledevops.live  # ✅ VuCar production URL

# 🗄️ Database Configuration (if needed)
# DATABASE_URL=mongodb://localhost:27017/vucar
# MONGODB_URI=mongodb://localhost:27017/vucar
# MONGO_PASSWORD=your-secure-password

# 🔐 Authentication
NEXTAUTH_SECRET=your-super-secret-production-key-very-long-and-random-change-this

# 🌐 External Services
# Add your production API keys and secrets here
# API_KEY=your-api-key
# JWT_SECRET=another-super-secret-key
# STRIPE_SECRET_KEY=sk_live_...
# PAYPAL_CLIENT_ID=your-paypal-client-id
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email
# SMTP_HOST=your-smtp-host
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password

# Cloudinary (if used)
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret