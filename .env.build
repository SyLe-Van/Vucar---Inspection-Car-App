# Environment variables for Jenkins build
# This file provides dummy values for build process

# MongoDB Connection (dummy for build)
MONGODB_URL=mongodb://localhost:27017/vucar-build

# Next.js Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=build-dummy-secret-32-chars-long-abc123def456

# API Configuration
API_URL=http://localhost:3000/api

# Build Environment
NODE_ENV=production

# Dummy secrets for build (not real credentials)
JWT_SECRET=dummy-jwt-secret-for-build
ENCRYPTION_KEY=dummy-encryption-key-for-build

# Third-party services (dummy values)
STRIPE_PUBLIC_KEY=pk_test_dummy
STRIPE_SECRET_KEY=sk_test_dummy
PAYPAL_CLIENT_ID=dummy-paypal-id

# Email (dummy values)
EMAIL_SERVER_HOST=smtp.example.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=dummy@example.com
EMAIL_SERVER_PASSWORD=dummy-password

# Google OAuth (dummy values)
GOOGLE_CLIENT_ID=dummy-google-client-id
GOOGLE_CLIENT_SECRET=dummy-google-secret

# Cloudinary (dummy values)
CLOUDINARY_CLOUD_NAME=dummy-cloud
CLOUDINARY_API_KEY=dummy-api-key
CLOUDINARY_API_SECRET=dummy-api-secret