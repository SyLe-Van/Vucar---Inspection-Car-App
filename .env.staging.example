# Staging Environment Variables
# Copy this file to .env.staging and update with your actual values

# Application
ENVIRONMENT=staging
APP_PORT=8080
DOCKER_REGISTRY=your-registry.com
DOCKER_IMAGE_NAME=vucar-app
DOCKER_TAG=staging-latest

# Database
DATABASE_URL=mongodb://your-staging-db:27017/vucar-staging
MONGODB_URI=mongodb://your-staging-db:27017/vucar-staging

# Authentication
NEXTAUTH_SECRET=your-staging-secret-key
NEXTAUTH_URL=https://staging-your-domain.com

# External Services (use test/sandbox APIs)
# STRIPE_SECRET_KEY=sk_test_...
# PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id

# Email (use test SMTP or mailtrap)
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=your-mailtrap-user
# SMTP_PASS=your-mailtrap-password