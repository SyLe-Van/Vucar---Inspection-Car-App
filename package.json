{
  "name": "vucar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "analyze": "cross-env ANALYZE=true npm run build",
    "clean": "rm -rf .next out dist",
    "env:local": "./scripts/env-manager.sh local",
    "env:build": "./scripts/env-manager.sh local-build",
    "env:prod": "./scripts/env-manager.sh production-load",
    "env:status": "./scripts/env-manager.sh status",
    "docker:build": "docker build -t vucar-app .",
    "docker:run": "docker run -p 3000:3000 vucar-app",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up --build",
    "docker:prod": "docker-compose -f docker-compose.production.yml up -d",
    "pre-commit": "lint-staged",
    "prepare": "husky install"
  },
  "dependencies": {
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^5.16.7",
    "@mui/lab": "^5.0.0-alpha.173",
    "@mui/material": "^5.16.7",
    "@mui/x-date-pickers": "^7.13.0",
    "@next-auth/mongodb-adapter": "^1.1.3",
    "@nextui-org/radio": "^2.1.5",
    "@nextui-org/react": "^2.4.8",
    "@paypal/react-paypal-js": "^8.5.0",
    "@redux-devtools/extension": "^3.3.0",
    "@reduxjs/toolkit": "^2.2.7",
    "@stripe/react-stripe-js": "^2.8.0",
    "@stripe/stripe-js": "^4.3.0",
    "axios": "^1.3.1",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "dayjs": "^1.11.12",
    "express-fileupload": "^1.5.1",
    "formik": "^2.4.6",
    "framer-motion": "^11.5.4",
    "fs": "^0.0.1-security",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^5.9.2",
    "mongoose": "^8.5.2",
    "next": "14.2.5",
    "next-auth": "^4.24.7",
    "next-cloudinary": "^6.10.0",
    "next-connect": "^1.0.0",
    "next-redux-wrapper": "^8.1.0",
    "nodemailer": "^6.9.14",
    "react": "^18.3.1",
    "react-dom": "^18",
    "react-icons": "^5.2.1",
    "react-redux": "^9.1.2",
    "react-responsive": "^10.0.0",
    "react-share": "^5.1.0",
    "react-spinners": "^0.14.1",
    "react-toastify": "^10.0.5",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "redux-thunk": "^3.1.0",
    "sass": "^1.77.8",
    "slugify": "^1.6.6",
    "stripe": "^16.8.0",
    "swiper": "^11.1.9",
    "tailwindcss": "^3.4.12",
    "yup": "^1.4.0",
    "yup-phone": "^1.3.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.2.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
