# VuCar Application - Environment Variables Template
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to Git!

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# MongoDB Connection String
# Format: mongodb+srv://username:password@cluster.mongodb.net/database_name
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/your_database

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Application Environment (development, staging, production)
NODE_ENV=development

# Application URL (for callbacks, redirects, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# JWT Secret Key (generate a strong random string)
JWT_SECRET=your_super_secret_jwt_key_here

# API Keys (if any)
API_KEY=your_api_key_here

# =============================================================================
# THIRD-PARTY SERVICES
# =============================================================================
# Add your third-party service configurations here
# EXAMPLE_SERVICE_API_KEY=your_service_key

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
# Debug mode (true/false)
DEBUG=true

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# =============================================================================
# PRODUCTION CONFIGURATION
# =============================================================================
# SSL Configuration (for production)
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem

# =============================================================================
# IMPORTANT NOTES:
# =============================================================================
# 1. Copy this file to .env.local for development
# 2. Never commit actual environment files to Git
# 3. Use different databases for different environments
# 4. Keep production secrets secure and separate
# 5. Use Jenkins secrets or external config for production
# =============================================================================