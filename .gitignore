# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
package-lock.json.old

# Environment files (SECURITY CRITICAL - NEVER COMMIT THESE!)
.env
.env.*
!.env.example
!.env.*.example
!.env.*.template
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging
.env.staging.local

# Production environment files
environments/production/.env.production

# IMPORTANT: Production env contains real secrets - keep secure!
.env.production.local
.env.production
.env.staging
.logs_pipeline.txt

# Secure environment directories
secret-*
*.env.secure
vucar-secure/

# Testing
/coverage
/test-results/
/playwright-report/
/playwright/.cache/
*.lcov

# IDE and Editor history (can contain secrets)
/.history
/.vscode/settings.json
.idea/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.p12
*.crt
*.pfx

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# data
/data

# OS
Thumbs.db

# Deployment & CI/CD (sensitive files)
docker-compose.override.yml

# Secrets & Keys
secrets/
*.secrets
credentials.json
service-account.json

# Temporary files
temp/
tmp/
*.tmp

# Logs
logs/
*.log

# Backup files (may contain secrets)
*.backup
*.bak